<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_appearance_margin_horizontal"
    android:paddingTop="@dimen/settings_appearance_margin_vertical"
    android:paddingEnd="@dimen/settings_appearance_margin_horizontal"
    android:paddingBottom="@dimen/settings_appearance_margin_vertical"
    android:background="@color/panel">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/home_override_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_appearance_title_text"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/home_override_description"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/settings_pictures_small_text" />

    <TextView
        android:id="@+id/home_override_choose_home"
        style="@style/RabbitSettingsEntry"
        android:layout_marginBottom="16dp"
        android:text="@string/home_override_choose_home" />

    <Switch
        android:id="@+id/home_override_enabled"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_entry_height"
        android:layout_marginBottom="16dp"
        android:background="@drawable/entry_background"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="@dimen/settings_entry_padding"
        android:paddingEnd="@dimen/settings_entry_padding"
        android:text="@string/home_override_enable"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_entry_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/home_override_status_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_pictures_small_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_override_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_pictures_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/home_override_default_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_pictures_small_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_override_default_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_pictures_text" />

    <TextView
        android:id="@+id/home_override_configure"
        style="@style/RabbitSettingsEntry"
        android:text="@string/home_override_configure_accessibility" />

    <TextView
        android:id="@+id/home_override_restore"
        style="@style/RabbitSettingsEntry"
        android:layout_marginTop="8dp"
        android:text="@string/home_override_restore" />
</LinearLayout>
