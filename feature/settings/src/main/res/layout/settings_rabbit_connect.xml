<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/settings_appearance_margin_horizontal"
        android:paddingTop="@dimen/settings_appearance_margin_vertical"
        android:paddingEnd="@dimen/settings_appearance_margin_horizontal"
        android:paddingBottom="@dimen/settings_appearance_margin_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/rabbit_connect_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_appearance_title_text"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/rabbit_connect_description"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/settings_pictures_small_text" />

        <Switch
            android:id="@+id/rabbit_connect_enabled"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_entry_height"
            android:layout_marginBottom="12dp"
            android:background="@drawable/entry_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="@dimen/settings_entry_padding"
            android:paddingEnd="@dimen/settings_entry_padding"
            android:text="@string/rabbit_connect_enable"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_entry_text" />

        <TextView android:id="@+id/rabbit_connect_status" style="@style/RabbitSettingsBody" />
        <TextView android:id="@+id/rabbit_connect_ip" style="@style/RabbitSettingsBody" />
        <TextView android:id="@+id/rabbit_connect_code" style="@style/RabbitSettingsBody" />

        <TextView android:id="@+id/rabbit_connect_accessibility" style="@style/RabbitSettingsEntry" android:text="@string/rabbit_connect_accessibility" />
        <TextView android:id="@+id/rabbit_connect_overlay_permission" style="@style/RabbitSettingsEntry" android:text="@string/rabbit_connect_overlay_permission" />
        <TextView android:id="@+id/rabbit_connect_test" style="@style/RabbitSettingsEntry" android:text="@string/rabbit_connect_test" />
        <TextView android:id="@+id/rabbit_connect_revoke" style="@style/RabbitSettingsEntry" android:text="@string/rabbit_connect_revoke" />
    </LinearLayout>
</ScrollView>
