<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen's texts. Each translation, in values-<language>/, has every string here. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="rabbit_tv_title">Rabbit TV</string>
    <string name="rabbit_tv_apps_title">Apps</string>
    <string name="rabbit_tv_apps_hint">OK: abrir · Mantener OK o Menú: fijar o quitar de Inicio</string>
    <string name="home_dock_home">Inicio</string>
    <string name="home_dock_apps">Apps</string>
    <string name="home_dock_settings">Configuración</string>
    <!-- Shown in place of the tiles when the device has no TV apps. -->
    <string name="home_no_apps">No hay aplicaciones compatibles con TV instaladas</string>
    <!-- Shown in place of the tiles when every app is hidden. The settings panel's title and its
         Hide apps entry, as the panel shows them. -->
    <string name="home_all_hidden">No hay favoritas. Añade aplicaciones desde Apps.</string>
    <!-- The gear at the end of the top bar, for screen readers: it opens the settings panel. -->
    <string name="home_settings">Settings</string>
    <!-- Arrange mode: the top bar's title and which keys do what, and the shelf of hidden apps.
         OK and Back are the remote's buttons; the arrows are its D-pad, and stay as they are. -->
    <string name="home_arrange_title">Ordenar favoritas</string>
    <!-- While an app is held: the D-pad moves it, OK puts it down, Back ends arrange mode. -->
    <string name="home_arrange_hint_holding"><xliff:g id="arrows" example="↑↓←→">↑↓←→</xliff:g> Mover · OK Soltar · Atrás Terminar</string>
    <!-- While no app is held: OK picks up the focused app, Back ends arrange mode. -->
    <string name="home_arrange_hint_browsing">OK Seleccionar · Atrás Terminar</string>
    <!-- The label above the shelf of hidden apps. -->
    <string name="home_hidden">No favoritas</string>
    <!-- In the empty slot on the shelf, while no app is hidden. -->
    <string name="home_hidden_empty">Mueve aquí las apps que quieras ocultar</string>
    <!-- While the wallpaper is drawn again, in a window over the home screen, which waits for it:
         the TV's screen changed size (it switched to 4K, say), so the wallpaper is drawn for it. -->
    <string name="home_wallpaper_screen_changed">Fitting the background to this screen…</string>
    <!-- The same, when the wallpaper kept is outdated: Luncher was updated, or it's lost. -->
    <string name="home_wallpaper_outdated">Updating the background…</string>
    <!-- The same, while a new wallpaper saved in the background editor is drawn, which the user
         left before it was done: as that editor says it (settings_background_applying). -->
    <string name="home_wallpaper_saving">Processing background…</string>
    <string name="rabbit_home_override_service_name">Rabbit TV · Sustitución de pantalla de inicio</string>
    <string name="rabbit_home_override_service_description">Observa cambios de ventana de Google TV Home para abrir Rabbit TV cuando activás esta opción. No lee contenido de ventanas.</string>
</resources>
